# Copy to `.env.local` and fill in. Never commit real values.
# Every name below is validated by src/lib/env.ts.

# --- Public (inlined into the client bundle — nothing secret may live here) ---

# Absolute base URL of this deployment, e.g. the Vercel preview or production URL.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL. Required from T02.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon key — RLS-constrained, safe in the browser. Required from T02.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never referenced from a Client Component) ---

# Supabase service role key. Bypasses RLS. Server modules only. Required from T02.
SUPABASE_SERVICE_ROLE_KEY=

# Keepa API key for the Amazon marketplace adapter. Required from T17.
KEEPA_API_KEY=

# Shared secret guarding /api/cron/* routes. Required from T17.
CRON_SECRET=

# Stripe secret key. Required from T34.
STRIPE_SECRET_KEY=

# Stripe webhook signing secret, verified against the raw request body. Required from T34.
STRIPE_WEBHOOK_SECRET=
